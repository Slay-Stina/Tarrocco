<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tarrocco.MAUI.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Image
                Source="tarrocco_logo.jpg"
                Aspect="AspectFill" />
        <Grid
        Padding="50"
        ColumnDefinitions="*,*">
            <Button
                Grid.Column="0"
                Text="Kort"
                FontSize="Header"
                WidthRequest="200"
                HeightRequest="100"
                Clicked="CardsPage_ButtonClicked"
                VerticalOptions="End" 
                
                />
        <Button
            Grid.Column="1"
            Text="Spådom" 
            FontSize="Header"
            WidthRequest="200"
            HeightRequest="100"
            Clicked="FortunePage_ButtonClicked"
            VerticalOptions="End" 
            
            />

    </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Tarrocco.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Tarrocco.MAUI"
    xmlns:views="clr-namespace:Tarrocco.MAUI.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.FlyoutItemIsVisible="False"
    IsVisible="false"
    Title="Tarrocco.MAUI">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Cards"
        ContentTemplate="{DataTemplate views:CardPage}"
        Route="CardPage" />
    <ShellContent
        Title="Fortune"
        ContentTemplate="{DataTemplate views:FortunePage}"
        Route="FortunePage" />

</Shell>
